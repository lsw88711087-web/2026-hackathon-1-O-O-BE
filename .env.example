# 실제 값은 .env에 넣는다. .env는 절대 커밋하지 않는다.
# 로컬은 아래 기본값 그대로 두면 SQLite + LocMem으로 동작한다.
# 배포 서버용 값 예시는 deploy/README.md 참고.

# --- 공통 ---
DJANGO_SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Netlify PR 미리보기처럼 주소가 매번 바뀌는 경우에만 사용 (배포 서버 전용)
CORS_ALLOWED_ORIGIN_REGEXES=
CORS_ALLOW_ALL_ORIGINS=False
# https로 열린 django-admin에 로그인하려면 필요 (배포 서버 전용)
CSRF_TRUSTED_ORIGINS=

DEFAULT_STORE_ID=s_mcm

# --- AI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- 저장소 (배포에서만 채운다) ---
# 비우면 SQLite/LocMem. 배포에서는 반드시 둘 다 채운다.
# REDIS_URL이 비면 워커 2개에서 화보 폴링이 404가 난다.
DATABASE_URL=
REDIS_URL=

# --- 업로드 스토리지 ---
# local : 버킷 없이 Django가 PUT을 직접 받는다. 기본값이고 배포에서도 그대로 쓸 수 있다.
# s3    : R2·S3 버킷이 생기면 이걸로 바꾸고 아래 4개를 채운다. 코드는 안 고친다.
# dev   : presign URL이 uploads.invalid로 나간다. 실제로 받지 않는다(계약 확인 전용).
STORAGE_BACKEND=local
STORAGE_ENDPOINT_URL=
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# local일 때 사진이 저장되는 곳. 비우면 <repo>/uploads.
# ⚠️ media/ 아래로 옮기지 말 것. nginx가 /media/를 공개 서빙해서 얼굴 사진이 열린다.
UPLOAD_LOCAL_ROOT=

# --- 화보 ---
# 이미지 생성 벤더 실측 p50으로 교체할 것. 진행률 보간의 분모다.
LOOKBOOK_EXPECTED_SEC=25
# True면 벤더를 부르지 않고 8초 뒤 placeholder를 돌려준다. 키가 없거나 크레딧을
# 아껴야 하는 날에도 로딩·완료 화면 전체를 눌러볼 수 있다.
# 진짜 화보를 만들려면 False + 유효한 OPENAI_API_KEY + STORAGE_BACKEND=local(또는 s3).
LOOKBOOK_FAKE_AI=True
LOOKBOOK_IMAGE_MODEL=gpt-image-2
# 변의 길이가 16의 배수여야 한다. 1080x1350은 조건에 안 맞아 같은 4:5인 1024x1280을 쓴다.
LOOKBOOK_GEN_SIZE=1024x1280
LOOKBOOK_GEN_TIMEOUT_SEC=120
# 인물이 지워지고 배경만 남으면 True로 뒤집는다. 프론트 실루엣 극성이 반대인 경우다.
LOOKBOOK_MASK_INVERT=False
# cutout: 마스크로 인물만 오려 배경판에 얹는다. 공짜·즉시·얼굴 100% 원본.
# ai    : 벤더가 배경까지 새로 그린다. 느리고 비싸고 조직 한도에 걸린다.
LOOKBOOK_COMPOSE_MODE=cutout

# --- 배포 전용 (docker compose가 읽는다) ---
DOMAIN=
POSTGRES_DB=oando
POSTGRES_USER=oando
POSTGRES_PASSWORD=
